# Everything with a VITE_ prefix is compiled into the bundle and is public.
# Never put a secret here.

# Must stay on localhost, not 127.0.0.1: they are different cookie hosts, and
# mixing them makes the session silently disappear.
VITE_API_BASE_URL=http://localhost:8080/api

# false reads the live server: the catalogue, wallets, deposits, and the admin
# console are real, and a surface with no endpoint yet renders empty. true is the
# development-only fixture demo, where every surface shows sample data.
VITE_API_MOCK=false
