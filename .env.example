# Local development only. Never commit real secrets.
# Copy to .env:  cp .env.example .env
#
# The server reads its configuration from the environment, not from this file.
# The Makefile loads it for `make dev`, `make seed`, and `make test`; a real
# deployment injects these variables directly.

APP_PORT=8080

# PostgreSQL runs natively on this machine; see README.md for the one-time setup.
DATABASE_URL=postgres://gaming:gaming@localhost:5432/gaming_platform?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Opaque server-side sessions delivered via an HttpOnly cookie.
#
# SESSION_SECURE must be true anywhere the site is served over TLS. Left false
# here only because local development is plain http, where a Secure cookie would
# never be sent at all.
SESSION_COOKIE_NAME=gp_session
SESSION_TTL_HOURS=24
SESSION_SECURE=false

# Per-client budget for the endpoints that accept credentials.
LOGIN_ATTEMPTS_PER_MINUTE=10

# Exact origins only, comma separated. This list is both the CORS allowlist and
# the CSRF defence: a state-changing request whose Origin is not here is refused.
# A wildcard is illegal on credentialed requests and the browser silently drops
# the session cookie when it sees one.
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=debug

HTTP_MAX_BODY_BYTES=1048576

# The admin account `make seed` creates. Re-running seed restores the admin role,
# activates the account, and resets this password. Public registration can only
# create player accounts.
SEED_USER_EMAIL=owner@example.com
SEED_USER_PASSWORD=change-this-locally-please
SEED_USER_DISPLAY_NAME=Owner

# The web app ships against in-memory fixtures so the front-end runs with no API
# and no database. Set this to false to point sign-in, registration, sign-out and
# /me at the Go server on VITE_API_BASE_URL instead. The tests always run false.
VITE_API_MOCK=true
VITE_API_BASE_URL=http://localhost:8080/api
