# Local development only. Never commit real secrets.
# Copy to .env:  cp .env.example .env
#
# The server reads its configuration from the environment, not from this file.
# The Makefile loads it for `make dev`, `make seed`, and `make test`; a real
# deployment injects these variables directly.

APP_ENV=development
APP_PORT=8080

# PostgreSQL runs natively on this machine; see README.md for the one-time setup.
DATABASE_URL=postgres://gaming:gaming@localhost:5432/gaming_platform?sslmode=disable
# Tests never fall back to DATABASE_URL. The database name must end in `_test`.
TEST_DATABASE_URL=postgres://gaming:gaming@localhost:5432/gaming_platform_test?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Opaque server-side sessions delivered via an HttpOnly cookie.
#
# SESSION_SECURE must be true anywhere the site is served over TLS. Left false
# here only because local development is plain http, where a Secure cookie would
# never be sent at all.
SESSION_COOKIE_NAME=gp_session
SESSION_TTL_HOURS=24
SESSION_SECURE=false

# Enable only when the API is reachable exclusively through a trusted reverse
# proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Per-client budget for the endpoints that accept credentials.
LOGIN_ATTEMPTS_PER_MINUTE=10

# Password-reset email is off for local development. To enable Resend, set the
# provider to `resend`, use the public HTTPS origin that serves the web app, and
# supply a Resend API key and verified sender. The server refuses to start when
# any enabled-delivery value is invalid.
EMAIL_DELIVERY_PROVIDER=disabled
PUBLIC_WEB_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=

# Per-account budget for posting to the live chat.
CHAT_MESSAGES_PER_MINUTE=20

# A settled win at or above this multiplier, in hundredths (1000 is 10x the stake),
# notifies the player. 0 turns the notification off.
BIG_WIN_MULTIPLIER_HUNDREDTHS=1000

# Exact origins only, comma separated. This list is both the CORS allowlist and
# the CSRF defence: a state-changing request whose Origin is not here is refused.
# A wildcard is illegal on credentialed requests and the browser silently drops
# the session cookie when it sees one.
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=debug

HTTP_MAX_BODY_BYTES=6291456
PRIVATE_PROOF_DIR=storage/private/deposit-proofs

# Bootstrap creates this admin only when it is absent. Re-running bootstrap never
# resets its password or changes the account. Public registration creates players.
SEED_USER_EMAIL=owner@example.com
SEED_USER_PASSWORD=change-this-locally-please
SEED_USER_DISPLAY_NAME=Owner

# Demo data is refused outside development/staging and requires this explicit
# switch. Every demo player uses the password below. Opening balances are credited
# once, so re-seeding never tops a wallet up twice.
ALLOW_DEMO_SEED=true
SEED_PLAYER_PASSWORD=play-locally-please

VITE_API_BASE_URL=http://localhost:8080/api
