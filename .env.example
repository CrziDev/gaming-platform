# Local development only. Never commit real secrets.
# Copy to .env:  cp .env.example .env
#
# The server reads its configuration from the environment, not from this file.
# `make docker-*` passes it to Docker Compose, which hands it whole to the api
# container; staging uses .env.vps and production .env.prod (see deploy/README.md).

APP_ENV=development
APP_PORT=8080

# Used by docker-compose.yml. The site is served by Caddy at http://localhost:8080.
APP_ENV_FILE=.env
DB_PASSWORD=gaming
SITE_ADDRESS=http://localhost

# Host `db` is the Compose service; the password must match DB_PASSWORD.
DATABASE_URL=postgres://gaming:gaming@db:5432/gaming_platform?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Opaque server-side sessions delivered via an HttpOnly cookie.
#
# SESSION_SECURE must be true anywhere the site is served over TLS. Left false
# here only because local development is plain http, where a Secure cookie would
# never be sent at all.
SESSION_COOKIE_NAME=gp_session
SESSION_TTL_HOURS=24
SESSION_SECURE=false

# Enable only when the API is reachable exclusively through a trusted reverse
# proxy that sets X-Forwarded-For. Compose publishes no api port, so only Caddy
# reaches it.
TRUST_PROXY_HEADERS=true

# Per-client budget for the endpoints that accept credentials.
LOGIN_ATTEMPTS_PER_MINUTE=10

# Email is off for local development. When enabled it carries password-reset links
# and a new-deposit alert to every active administrator. Set the provider to
# `gmail` or `resend`, use the public HTTPS origin that serves the web app, and
# fill in that provider's values: Gmail takes an OAuth client ID and secret and a
# refresh token granted the gmail.send scope by the sending account; Resend takes
# an API key and a verified sender. The server refuses to start when any
# enabled-delivery value is invalid.
EMAIL_DELIVERY_PROVIDER=disabled
PUBLIC_WEB_URL=http://localhost:8080
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
RESEND_API_KEY=
RESEND_FROM=

# Per-account budget for posting to the live chat.
CHAT_MESSAGES_PER_MINUTE=20

# A settled win at or above this multiplier, in hundredths (1000 is 10x the stake),
# notifies the player. 0 turns the notification off.
BIG_WIN_MULTIPLIER_HUNDREDTHS=1000

# Exact origins only, comma separated. This list is both the CORS allowlist and
# the CSRF defence: a state-changing request whose Origin is not here is refused.
# A wildcard is illegal on credentialed requests and the browser silently drops
# the session cookie when it sees one.
CORS_ALLOWED_ORIGINS=http://localhost:8080

LOG_LEVEL=debug

HTTP_MAX_BODY_BYTES=6291456
PRIVATE_PROOF_DIR=/storage/private/deposit-proofs

# Bootstrap creates each admin in this comma-separated list only when it is absent,
# named from the address and signed in with the shared password below. Re-running
# bootstrap never resets a password or changes an account. Public registration
# creates players.
SEED_ADMIN_EMAILS=owner@example.com,second-owner@example.com
SEED_USER_PASSWORD=change-this-locally-please

# Demo data is refused outside development/staging and requires this explicit
# switch. Every demo player uses the password below. Opening balances are credited
# once, so re-seeding never tops a wallet up twice.
ALLOW_DEMO_SEED=true
SEED_PLAYER_PASSWORD=play-locally-please
