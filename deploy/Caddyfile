# SITE_ADDRESS is the public hostname, e.g. play.example.com. Caddy obtains and
# renews its TLS certificate automatically; use :80 for a plain-HTTP trial.
{$SITE_ADDRESS}

encode zstd gzip

handle /api/* {
	reverse_proxy api:8080
}

# The bundle's hashed files never change under their name. A game's vendored engine,
# audio, and images are kept for a day; everything else, the game code included, is
# revalidated on every visit so a deploy is never mixed with an older module.
handle {
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@gameMedia path_regexp ^/games/[^/]+/(js/vendor|audio|img)/
	header @gameMedia Cache-Control "public, max-age=86400"

	header ?Cache-Control "no-cache"

	root * /srv
	try_files {path} /index.html
	file_server
}
